{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCHGEN road settings V1",
  "type": "object",
  "properties": {
    "road_version": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "axis": {
      "enum": [
        "center",
        "left",
        "right"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "points_m": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "radii_m": {
          "type": "array",
          "maxItems": 62,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          }
        }
      },
      "required": [
        "points_m",
        "radii_m"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object"
    }
  },
  "required": [
    "trace",
    "profile"
  ],
  "additionalProperties": false
}
