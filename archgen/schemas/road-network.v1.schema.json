{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCHGEN road network V1",
  "type": "object",
  "properties": {
    "network_version": {
      "const": 1
    },
    "roads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "road": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "road"
        ],
        "additionalProperties": false
      }
    },
    "junctions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "type": {
            "enum": [
              "simple",
              "signals",
              "roundabout",
              "double_roundabout",
              "level_crossing",
              "bridge"
            ]
          },
          "bridge_kind": {
            "enum": [
              "beam",
              "arch",
              "vault"
            ]
          },
          "over": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "clearance_m": {
            "type": "number",
            "minimum": 2,
            "maximum": 30
          },
          "ramp_grade_percent": {
            "type": "number",
            "minimum": 2,
            "maximum": 8
          },
          "pair": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "outer_radius_m": {
            "type": "number",
            "minimum": 13,
            "maximum": 60
          },
          "ring_width_m": {
            "type": "number",
            "minimum": 6,
            "maximum": 12
          },
          "corner_radius_m": {
            "type": "number",
            "minimum": 2,
            "maximum": 30
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "roads"
  ],
  "additionalProperties": false
}
