{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCHGEN road profile V1",
  "type": "object",
  "properties": {
    "road_profile_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z_]{1,32}$"
          },
          "width_m": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z_]{1,32}$"
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[a-z_]{1,32}$"
                },
                "height_m": {
                  "type": "number"
                },
                "spacing_m": {
                  "type": "number"
                },
                "height_variation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.3
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "width_m"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bands"
  ],
  "additionalProperties": false
}
