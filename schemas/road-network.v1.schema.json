{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCHGEN road network V1",
  "type": "object",
  "properties": {
    "network_version": {
      "const": 1
    },
    "roads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "road": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "road"
        ],
        "additionalProperties": false
      }
    },
    "junctions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "corner_radius_m": {
            "type": "number",
            "minimum": 2,
            "maximum": 30
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "roads"
  ],
  "additionalProperties": false
}
